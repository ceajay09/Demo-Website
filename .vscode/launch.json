{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Spring Boot (dev)",
      "request": "launch",
      "mainClass": "com.example.myproject.Application",
      "vmArgs": "-Dspring.profiles.active=dev"
    },
    {
      "type": "pwa-chrome",
      "name": "Frontend: Chrome (local)",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/My-App_Frontend",
      "preLaunchTask": "Frontend: npm starten"
    }
  ]
}
